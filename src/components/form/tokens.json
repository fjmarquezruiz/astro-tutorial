{
  "colors": {
    "input": {
      "bg": "#FFFFFF",
      "text": "#0B0B0B",
      "placeholder": "#8A8A8A",
      "border": "#E3E5E8",
      "borderHover": "#C9CDD1",
      "borderFocus": "#6EA8FE",
      "error": "#E04E4E",
      "success": "#16A34A",
      "disabledBg": "#F5F6F7",
      "disabledText": "#9CA3AF"
    }
  },
  "typography": {
    "fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue'",
    "size": {
      "small": 14,
      "large": 16
    },
    "lineHeight": 20
  },
  "spacing": {
    "paddingSmall": "8px 12px",
    "paddingLarge": "12px 16px",
    "labelGap": "8px",
    "radius": "8px"
  },
  "focus": {
    "ringWidth": 2,
    "ringColor": "#6EA8FE"
  }
}
